<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_inherit_sender" model="ir.ui.view">
        <field name="name">project.project.form.inherit.sender</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='settings']" position="inside">
                <group string="Changelog Push Settings">
                    <group>
                        <field name="enable_changelog_push" widget="boolean_toggle"/>
                    </group>
                    <group invisible="not enable_changelog_push">
                        <field name="client_endpoint_id" required="enable_changelog_push"/>
                        <field name="changelog_stage_id" domain="[('project_ids', 'in', id)]"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
