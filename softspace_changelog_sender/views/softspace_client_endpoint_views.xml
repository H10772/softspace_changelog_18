<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_softspace_client_endpoint_form" model="ir.ui.view">
        <field name="name">softspace.client.endpoint.form</field>
        <field name="model">softspace.client.endpoint</field>
        <field name="arch" type="xml">
            <form string="Client Endpoint">
                <header>
                    <button name="action_check_health" type="object"
                            string="🏥 Check Health" class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-heartbeat" disabled="1">
                            <div class="o_stat_info">
                                <field name="health_status" widget="badge"
                                       decoration-success="health_status == 'ok'"
                                       decoration-danger="health_status == 'failed'"
                                       decoration-muted="health_status == 'unknown'"/>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Client Name"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="domain" placeholder="odoo.client.com"/>
                            <field name="use_https"/>
                            <field name="api_path" invisible="1"/>
                            <field name="api_url" readonly="1"/>
                        </group>
                        <group string="Authentication">
                            <field name="api_token" password="True"/>
                            <button name="action_generate_token" type="object"
                                    string="🔑 Generate Token" class="btn-secondary"
                                    confirm="This will replace the current token. Continue?"/>
                            <field name="use_hmac"/>
                            <field name="hmac_secret" password="True" invisible="not use_hmac"/>
                            <button name="action_generate_hmac_secret" type="object"
                                    string="🔐 Generate HMAC Secret" class="btn-secondary"
                                    invisible="not use_hmac"
                                    confirm="This will replace the current HMAC secret. Continue?"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="last_health_check" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Any notes about this client..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_softspace_client_endpoint_tree" model="ir.ui.view">
        <field name="name">softspace.client.endpoint.tree</field>
        <field name="model">softspace.client.endpoint</field>
        <field name="arch" type="xml">
            <list string="Client Endpoints">
                <field name="name"/>
                <field name="domain"/>
                <field name="api_url"/>
                <field name="use_https" widget="boolean_toggle"/>
                <field name="health_status" widget="badge"
                       decoration-success="health_status == 'ok'"
                       decoration-danger="health_status == 'failed'"
                       decoration-muted="health_status == 'unknown'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_softspace_client_endpoint" model="ir.actions.act_window">
        <field name="name">Client Endpoints</field>
        <field name="res_model">softspace.client.endpoint</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_softspace_sender_root" name="Softspace" sequence="99"/>
    <menuitem id="menu_softspace_clients" name="Client Endpoints"
              parent="menu_softspace_sender_root"
              action="action_softspace_client_endpoint"
              sequence="10"/>

</odoo>
