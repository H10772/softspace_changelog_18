<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_changelog_api_log_tree" model="ir.ui.view">
        <field name="name">softspace.changelog.api.log.tree</field>
        <field name="model">softspace.changelog.api.log</field>
        <field name="arch" type="xml">
            <list string="API Logs" decoration-danger="status in ('auth_failed', 'error')"
                  decoration-warning="status == 'rate_limited'"
                  decoration-success="status == 'success'">
                <field name="create_date" string="Time"/>
                <field name="request_ip"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status in ('auth_failed', 'error')"
                       decoration-warning="status == 'rate_limited'"
                       decoration-info="status == 'bad_request'"/>
                <field name="status_code"/>
                <field name="external_id"/>
                <field name="hmac_valid"/>
                <field name="response_time_ms" string="Time (ms)"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="view_changelog_api_log_form" model="ir.ui.view">
        <field name="name">softspace.changelog.api.log.form</field>
        <field name="model">softspace.changelog.api.log</field>
        <field name="arch" type="xml">
            <form string="API Log Entry" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Time"/>
                            <field name="request_ip"/>
                            <field name="request_method"/>
                            <field name="request_path"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="status_code"/>
                            <field name="external_id"/>
                            <field name="hmac_valid"/>
                            <field name="response_time_ms"/>
                        </group>
                    </group>
                    <group string="Error Details" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_changelog_api_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">softspace.changelog.api.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <menuitem id="menu_softspace_api_logs" name="API Logs"
              parent="menu_softspace_receiver_root"
              action="action_changelog_api_log"
              sequence="20"
              groups="base.group_system"/>

</odoo>
