<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone settings form for Changelog API -->
    <record id="view_changelog_api_settings" model="ir.ui.view">
        <field name="name">Changelog API Settings</field>
        <field name="model">res.config.settings</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Changelog API Settings" class="oe_form_configuration">
                <header>
                    <button string="Save" type="object" name="execute" class="oe_highlight"/>
                    <button string="Discard" type="object" name="cancel" special="cancel"/>
                </header>
                <div class="o_setting_container">
                    <div class="settings">
                        <div class="app_settings_block">
                            <h2>Authentication</h2>
                            <div class="row mt16 o_settings_container">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane"/>
                                    <div class="o_setting_right_pane">
                                        <label for="changelog_api_token" string="API Token"/>
                                        <div class="text-muted">Bearer token that the Sender must include in requests</div>
                                        <div class="mt8">
                                            <field name="changelog_api_token" password="True"/>
                                        </div>
                                        <div class="mt8">
                                            <button name="action_generate_api_token" type="object"
                                                    string="🔑 Generate New Token" class="btn-secondary btn-sm"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane">
                                        <field name="changelog_require_hmac"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label for="changelog_require_hmac" string="Require HMAC Signature"/>
                                        <div class="text-muted">Verify HMAC-SHA256 signature on incoming requests</div>
                                        <div class="mt8" invisible="not changelog_require_hmac">
                                            <field name="changelog_hmac_secret" password="True"/>
                                            <div class="mt8">
                                                <button name="action_generate_hmac_secret" type="object"
                                                        string="🔐 Generate HMAC Secret" class="btn-secondary btn-sm"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <h2 class="mt32">Security</h2>
                            <div class="row mt16 o_settings_container">
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane"/>
                                    <div class="o_setting_right_pane">
                                        <label for="changelog_allowed_ips" string="IP Whitelist"/>
                                        <div class="text-muted">Comma-separated IPs allowed to send requests. Empty = allow all.</div>
                                        <div class="mt8">
                                            <field name="changelog_allowed_ips"
                                                   placeholder="e.g. 41.33.100.50, 192.168.1.100"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box">
                                    <div class="o_setting_left_pane"/>
                                    <div class="o_setting_right_pane">
                                        <label for="changelog_max_request_age" string="Max Request Age"/>
                                        <div class="text-muted">Reject requests older than this (anti-replay). 0 = disabled.</div>
                                        <div class="mt8">
                                            <field name="changelog_max_request_age" class="w-25"/>
                                            <span class="ml8">seconds</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="action_changelog_api_settings" model="ir.actions.act_window">
        <field name="name">Changelog API Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_changelog_api_settings"/>
        <field name="target">inline</field>
        <field name="context">{'module': 'softspace_changelog_receiver'}</field>
    </record>

    <menuitem id="menu_changelog_api_settings"
              name="API Settings"
              parent="menu_softspace_receiver_root"
              action="action_changelog_api_settings"
              sequence="30"
              groups="base.group_system"/>

</odoo>
